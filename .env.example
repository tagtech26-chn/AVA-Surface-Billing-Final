# Frontend / existing app settings
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# .NET backend settings
# Set these as process/environment variables for the server.
# Never commit real secrets.
Authentication__JwtSecret="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES"
ConnectionStrings__DefaultConnection="Server=.\\SQLEXPRESS;Database=AVASurfaceBilling;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
Cors__AllowedOrigins__0="http://localhost:5173"
Cors__AllowedOrigins__1="http://localhost:4173"
